# Environment Variables (example)

# API key for your LLM (LM Studio, OpenAI, etc.)
LLM_API_KEY=OPENAI_API_KEY

# Base URL for your LLM API endpoint (e.g., LM Studio)
LLM_API_BASE_URL=https://api.openai.com/v1/

# Model identifier to use for chat completions
LLM_MODEL=gpt-5-mini-2025-08-07

# LLM Temperature for chat completions (e.g., 0.1 for more deterministic, 0.7 for more creative)
# Must be a number between 0 and 2. If not set, temperature will not be passed to LLM (using provider default). If invalid, defaults to 0.1.
LLM_TEMPERATURE= # gpt-5 mini does not support temperature
